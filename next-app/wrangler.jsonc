{
  "$schema": "node_modules/wrangler/config-schema.json",

  "name": "next-app",

  "main": ".open-next/worker.js",

  "compatibility_date": "2026-09-26",

  "compatibility_flags": [
    "nodejs_compat"
  ],

  "assets": {
    "binding": "ASSETS",
    "directory": ".open-next/assets"
  },

  "observability": {
    "enabled": true
  }
}
